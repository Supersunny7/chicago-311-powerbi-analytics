table FactRequests
	lineageTag: fff0da92-6273-4c81-a838-d55302d840de

	measure Requests = CALCULATE(COUNTROWS(FactRequests), FactRequests[is_included] = TRUE())
		formatString: #,0
		displayFolder: Service operations
		lineageTag: 155c53c9-f5c1-4a9d-a4c5-24ab9a82ab7a

	measure 'Closed Requests' = CALCULATE([Requests], FactRequests[status_closed] = TRUE())
		formatString: #,0
		displayFolder: Service operations
		lineageTag: a6823d85-40ad-4bc7-b402-c5bd5181f6f2

	measure 'Open Cohort Requests' = CALCULATE([Requests], FactRequests[is_open] = TRUE())
		formatString: #,0
		displayFolder: Service operations
		lineageTag: 61f357de-7623-450f-b300-011884f2c2fb

	measure 'Closed Share' = DIVIDE([Closed Requests], [Requests])
		formatString: 0.0%
		displayFolder: Service operations
		lineageTag: 87ccccef-d19e-4e66-b1bc-848cfc000763

	measure 'Valid Closed Requests' = CALCULATE([Requests], FactRequests[valid_closed] = TRUE())
		formatString: #,0
		displayFolder: Service operations
		lineageTag: 9661bd55-15a5-464f-b52a-2caaf18c6a8b

	measure 'Median Closed Days' = CALCULATE(MEDIAN(FactRequests[resolution_days]), FactRequests[is_included] = TRUE(), FactRequests[valid_closed] = TRUE())
		formatString: 0.0
		displayFolder: Service operations
		lineageTag: 470c6689-96fc-4856-a069-a33e1f8fc7cd

	measure 'P90 Closed Days' = PERCENTILEX.INC(FILTER(FactRequests, FactRequests[is_included] && FactRequests[valid_closed]), FactRequests[resolution_days], 0.9)
		formatString: 0.0
		displayFolder: Service operations
		lineageTag: 27c84023-4990-43c8-a91e-8f77a8d190b7

	measure 'Median Open Age Days' = CALCULATE(MEDIAN(FactRequests[open_age_days]), FactRequests[is_included] = TRUE(), FactRequests[is_open] = TRUE())
		formatString: 0.0
		displayFolder: Service operations
		lineageTag: 4e1559ca-f3cb-4344-94a3-d9f320fa7b9f

	measure 'Open Over 90 Days' = CALCULATE([Open Cohort Requests], FactRequests[open_age_days] > 90)
		formatString: #,0
		displayFolder: Service operations
		lineageTag: be4eebe0-4ca1-4571-98f2-b375d803a406

	measure 'Open Over 90 Share' = DIVIDE([Open Over 90 Days], [Open Cohort Requests])
		formatString: 0.0%
		displayFolder: Service operations
		lineageTag: 719dd482-c4fc-4c20-8c92-36c9fb7dbb6d

	/// Included completed requests with missing, negative, or post-snapshot closure duration; zero means no invalid dates.
	measure 'Invalid Closed Dates' = COALESCE(CALCULATE([Closed Requests], FactRequests[valid_closed] = FALSE()), 0)
		formatString: #,0
		displayFolder: Service operations
		lineageTag: 11d0f3b0-f4ea-4b41-96f6-fa4c793fac3a

