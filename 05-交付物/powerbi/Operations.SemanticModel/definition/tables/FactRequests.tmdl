	/// Open request age bands: 0–7, greater than 7–30, greater than 30–90, and over 90 fractional days. Not an official SLA.
	column age_band
		dataType: string
		lineageTag: 3a76a594-c20a-4230-a4c3-e86b157f7d9f
		summarizeBy: none
		sourceColumn: age_band
		sortByColumn: 'Age band order'

	column origin
		dataType: string
		lineageTag: 6acf5972-e1bb-42a4-be42-3159e3a707ac
		summarizeBy: none
		sourceColumn: origin

	column owner_department
		dataType: string
		lineageTag: 9577afbe-7797-4cc5-b400-3357208f20af
		summarizeBy: none
		sourceColumn: owner_department

	/// Chronological ordering for open-request age bands at the fixed extraction snapshot.
	column 'Age band order' = SWITCH(TRUE(), ISBLANK(FactRequests[open_age_days]), BLANK(), FactRequests[open_age_days] <= 7, 1, FactRequests[open_age_days] <= 30, 2, FactRequests[open_age_days] <= 90, 3, 4)
		dataType: int64
		isHidden
		lineageTag: 77eb5117-23a6-4eb3-bd57-7ed1cad0e5ec

	partition FactRequests = m
		mode: import
		source =
				let
				 Source = Csv.Document(File.Contents("C:/Users/sunny/Documents/MSIT Northwestern/projects/project-0011-Chicago311-PowerBI/03-执行内容/data/FactRequests.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				 Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				 Typed = Table.TransformColumnTypes(Headers, {{"sr_number", type text}, {"service_type", type text}, {"status", type text}, {"created_day", type date}, {"closed_day", type date}, {"created_month", type text}, {"created_week", type text}, {"community_area", Int64.Type}, {"ward", Int64.Type}, {"duplicate", type logical}, {"legacy_record", type logical}, {"is_included", type logical}, {"status_closed", type logical}, {"valid_closed", type logical}, {"is_open", type logical}, {"is_canceled", type logical}, {"resolution_days", type number}, {"open_age_days", type number}, {"age_band", type text}, {"origin", type text}, {"owner_department", type text}}, "en-US")
				in
				 Typed

